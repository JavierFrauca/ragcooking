---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ESTACIONES, FASES } from '../data/catalogo';
const B = import.meta.env.BASE_URL;
---

<BaseLayout>
  <section class="home-hero">
    <span class="kicker">ragcooking.info · el recetario del RAG</span>
    <h1>Todo RAG es una <em>receta</em>.<br />Aprende los ingredientes y cocina la tuya.</h1>
    <p class="sub">
      Qué es un RAG, cada pieza del pipeline explicada con ejemplos, y un lienzo donde compones tu
      arquitectura apilando piezas — con validación, guardado en tu navegador y exportación a JSON.
    </p>
    <div class="home-ctas">
      <a class="btn primario" href={`${B}constructor`}><i data-lucide="chef-hat"></i> Cocina tu RAG</a>
      <a class="btn secundario" href={`${B}biblioteca`}><i data-lucide="book-open"></i> Explora la biblioteca</a>
      <a class="btn" href={`${B}diccionario`}><i data-lucide="book-a"></i> Diccionario</a>
    </div>
  </section>

  <section style="max-width:1060px;margin:0 auto;padding:0 26px">
    <h2 style="text-align:center">La receta, paso a paso</h2>
    <p style="text-align:center">
      Las {FASES.length} fases agrupadas en {ESTACIONES.length} estaciones — como en cocina real:
    </p>
    <div class="receta-animada">
      {
        ESTACIONES.map((est, i) => (
          <div class="paso-receta" style={`animation-delay:${i * 1.4}s`}>
            <div class="icono-bola" style={`background:${est.color}`}>
              <i data-lucide={est.icon} />
            </div>
            <span class="paso-n">Estación {i + 1}</span>
            <h3>{est.nombre}</h3>
            <p>
              {FASES.filter((f) => f.est === est.id)
                .map((f) => f.nombre)
                .join(', ')}
              .
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="flujo-maestro">
    <h2>Primero determinista, luego semántico</h2>
    <p style="max-width:660px;margin:6px auto;color:var(--tinta-2)">
      La regla de oro de la recuperación: primero se decide qué información <b>puede competir</b>
      (filtros deterministas); después qué es <b>relevante</b> (semántica). Nunca al revés — y nunca el
      LLM como autoridad de seguridad.
    </p>
    <div class="pasos">
      {
        ['IDENTIDAD', 'REGLAS', 'FILTRO DETERMINISTA', 'BÚSQUEDA SEMÁNTICA', 'RERANKING', 'LLM'].map(
          (paso, i) => (
            <>
              <span class={`paso-fm ${i < 3 ? 'determinista' : ''}`} style={`animation-delay:${i * 0.6}s`}>
                {paso}
              </span>
              {i < 5 && <span class="flecha" style={`animation-delay:${i * 0.6 + 0.3}s`}>→</span>}
            </>
          ),
        )
      }
    </div>
  </section>

  <section style="max-width:1060px;margin:0 auto;padding:0 26px 80px">
    <div class="cartones">
      <a class="carton" href={`${B}biblioteca`}>
        <div class="icono-carton" style="background:#6B8E4E"><i data-lucide="book-open"></i></div>
        <h3>La biblioteca</h3>
        <p>
          Cada fase con su página y cada pieza con su ficha: alcance, cuándo usarla, ejemplos y tablas
          de «cómo elegir».
        </p>
      </a>
      <a class="carton" href={`${B}constructor`}>
        <div class="icono-carton" style="background:#C14B2E"><i data-lucide="chef-hat"></i></div>
        <h3>El constructor</h3>
        <p>
          Elige tus fases, apila piezas, valida la cobertura, comenta bloques y guarda tu receta en el
          navegador. Exporta a JSON.
        </p>
      </a>
      <a class="carton" href={`${B}diccionario`}>
        <div class="icono-carton" style="background:#D9A02B"><i data-lucide="book-a"></i></div>
        <h3>El diccionario</h3>
        <p>
          Todo término técnico del sitio enlaza a su explicación didáctica. Nadie se queda fuera por
          vocabulario.
        </p>
      </a>
    </div>
    <p style="text-align:center;font-family:var(--serif);font-style:italic;font-size:16px">
      «El 80% del éxito de un RAG ocurre antes del prompt.»
    </p>
  </section>
</BaseLayout>

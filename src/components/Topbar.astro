---
interface Props {
  titulo?: string;
}
const { titulo = 'ragcooking.info — el recetario del RAG' } = Astro.props;
const ruta = Astro.url.pathname;
const activa = (prefijo: string) => (ruta === prefijo || (prefijo !== '/' && ruta.startsWith(prefijo)) ? 'activo' : '');
const B = import.meta.env.BASE_URL;
---

<header class="topbar">
  <a class="marca" href={B}><span class="logo"><i data-lucide="chef-hat"></i></span>rag<em>cooking</em></a>
  <span class="sep"></span>
  <nav class="nav-links">
    <a class={activa('/')} href={B}>inicio</a>
    <a class={activa('/biblioteca')} href={`${B}biblioteca`}>biblioteca</a>
    <a class={activa('/constructor')} href={`${B}constructor`}>cocina tu rag</a>
    <a class={activa('/diccionario')} href={`${B}diccionario`}>diccionario</a>
    <a class={activa('/legal')} href={`${B}legal`}>legal</a>
  </nav>
  <span class="espacio"></span>
</header>

<script is:inline src={import.meta.env.BASE_URL + 'vendor/lucide.min.js'}></script>
<script>
  // inicializa iconos lucide en carga normal Y en navegaciones de astro
  const initIconosTop = () => (window as any).lucide?.createIcons();
  document.addEventListener('DOMContentLoaded', initIconosTop);
  document.addEventListener('astro:page-load', initIconosTop);
</script>
